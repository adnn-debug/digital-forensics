# ==============================================================================
# PS-05 Digital Evidence Verification Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Centralized API Settings
API_V1_STR=/api/v1
PROJECT_NAME="PS-05 Digital Evidence Platform"
SECRET_KEY=ps05-insecure-dev-key-change-in-production-min32chars!

# Network & Host
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=forensic_admin
POSTGRES_PASSWORD=forensic_secure_pass_2026
POSTGRES_DB=ps05_evidence_db
DATABASE_URL=postgresql+asyncpg://forensic_admin:forensic_secure_pass_2026@localhost:5432/ps05_evidence_db

# Fallback for development/testing when external PostgreSQL is not running:
# DATABASE_URL=sqlite+aiosqlite:///./storage/ps05_dev.db

# Redis Message Broker & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Private Local Storage Paths (Relative to repository root or absolute)
STORAGE_BASE_PATH=./storage
STORAGE_ORIGINALS_PATH=./storage/originals
STORAGE_ARTIFACTS_PATH=./storage/artifacts
STORAGE_REPORTS_PATH=./storage/reports
STORAGE_TMP_PATH=./storage/tmp
STORAGE_MAX_UPLOAD_SIZE_BYTES=5368709120  # 5 GB
